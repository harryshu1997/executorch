        <mxCell id="title" value="2-phone collaboration: local server (wifi) vs cloud (cellular) — 30 s synthetic AR/VR session" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontColor=#000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1410" height="28" as="geometry"/></mxCell>
