# Large model artifacts and binary blobs (rebuild from source scripts)
*.pte
*.dlc
*.bin
*.so
*.onnx
*.onnx.data
*.pt
*.pth
*.safetensors
*.raw
*.etdp

# Phone-side outputs
outputs/
outputs_*/

# Caches
__pycache__/
*.pyc

# Datasets (must be re-downloaded by users with proper access)
aria_data/

# Build/run artifacts
*.log
emulator_outputs/

# Output dirs from QNN export experiments (regenerable)
dlv3_qnn_op15/
qnn_*_op12/
qnn_*_op15/

# Whisper QNN artifacts (regenerable from onnx_export_whisper.py)
whisper_qnn_op15/whisper_*.pte
whisper_qnn_op15/whisper_enc.onnx*
whisper_qnn_op15/whisper_*.raw

# StreamVGGT output dirs (regenerable from export scripts)
streamvggt/streamvggt_agg_*.pte
streamvggt/in_*.raw
streamvggt/input_*.raw

